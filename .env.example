# חיבור ישיר של שרת האפליקציה ל-MCP של ה-ERP (אותו endpoint/token של קונקטור Claude).
# העתק ל-.env (נמצא ב-.gitignore) ומלא את הערכים — אל תשמור טוקנים בגיט.
ERP_MCP_URL=
ERP_MCP_TOKEN=
# אופציונלי: תבנית כתובת דף פרויקט באפליקציית ה-ERP ({id} יוחלף). ברירת מחדל: <origin>/project/{id}
ERP_WEB_PROJECT_URL=
# פרסום הקיטים ל-ERP (מסך הקיטים → "פרסום קיטים ל-ERP", ואוטומטית בשמירה/מחיקה/הסתרה של קיט): PUT <ERP_API_URL>/api/external/kits.
# ERP_API_URL = כתובת אפליקציית ה-ERP, בלי / בסוף. ERP_KITS_TOKEN = טוקן שירות שה-ERP מנפיק למקור ko-projects (לא טוקן ה-MCP).
# ריקים = הפרסום מושבת והכפתור מציג למה.
ERP_API_URL=
ERP_KITS_TOKEN=
# מפתח Claude API לזיהוי אזורים אוטומטי ולפריסה החכמה (console.anthropic.com → API Keys).
# כשהוא מוגדר, השרת מבצע את הקריאה והדפדפן לא רואה את המפתח — לא נשאלים עליו בממשק.
# חיוב: יתרת ה-API בקונסולה, בנפרד ממנוי Claude.
ANTHROPIC_API_KEY=
# אופציונלי: מודל אחר (ברירת מחדל claude-sonnet-5; claude-opus-5 חזק יותר בקריאת תכניות ויקר יותר)
ANTHROPIC_MODEL=
# תמונת התכנית נשלחת כ-base64 — adapter-node חוסם גוף בקשה מעל 512K כברירת מחדל
BODY_SIZE_LIMIT=10M

# אחסון משותף: דלי Cloud Storage שבו יושבים הפרויקטים, המשתמשים, הבאגים, ההעלאות ומצב הטבלאות.
# מוגדר = השרת המקומי והענן עובדים על אותם נתונים (אימות: gcloud auth login במחשב). ריק = קבצים מקומיים (data/).
DATA_BUCKET=scripts-298706-ko-projects-data
# הכתובת הציבורית של השרת — קישורי שיתוף/בעלים נבנים ממנה גם כשיוצרים אותם מהמחשב
PUBLIC_URL=https://ko-projects-226076433415.me-west1.run.app
